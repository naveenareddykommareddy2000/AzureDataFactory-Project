{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFProjectCovid-19"
		},
		"ls_ablob_covidadfprojectsa_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_ablob_covidadfprojectsa'"
		},
		"ls_adls_covidreportdl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_covidreportdl'"
		},
		"ls_adls_covidreportdl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlcovidreport.dfs.core.windows.net/"
		},
		"tr_ingest_population_data_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/88d99574-fb5e-4d21-a8a1-8c865af86d28/resourceGroups/ADF-Resource/providers/Microsoft.Storage/storageAccounts/covidadfprojectsa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFProjectCovid-19_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_ablob_covidadfprojectsa_connectionString": {
						"value": "[parameters('ls_ablob_covidadfprojectsa_connectionString')]"
					},
					"ls_adls_covidreportdl_accountKey": {
						"value": "[parameters('ls_adls_covidreportdl_accountKey')]"
					},
					"ls_adls_covidreportdl_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_covidreportdl_properties_typeProperties_url')]"
					},
					"tr_ingest_population_data_properties_typeProperties_scope": {
						"value": "[parameters('tr_ingest_population_data_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}